<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Multitool.Desktop</RootNamespace>
    <AssemblyName>Multitool</AssemblyName>
    <Version>0.1.0</Version>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishAot Condition="'$(Aot)' == 'true'">true</PublishAot>
    <PublishTrimmed Condition="'$(Trim)' == 'true'">true</PublishTrimmed>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Multitool.App/Multitool.App.csproj" />
    <ProjectReference Include="../../external/CupriFace/src/CupriFace.Shell/CupriFace.Shell.csproj" />
  </ItemGroup>
</Project>
